{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "proj-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
